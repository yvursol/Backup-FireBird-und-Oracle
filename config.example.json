    "IgnoreInvalidCertificate": false,
    "Quiesce": true,
    "VirtualMachines": [
      "vm-db-01",
      "vm-app-01"
    ]
  },
  "FireBird": {
    "Enabled": true,
    "GbakPath": "C:\\Program Files\\Firebird\\Firebird_3_0\\gbak.exe",
